#!/bin/bash
#SBATCH --job-name=misc_gdt_chromvar
#SBATCH --partition=cpu
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=06:00:00
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err
set -euo pipefail
WORKDIR=/path/to/workdir
# container cache/tmp settings go here
export APPTAINER_BIND="/path/to/FigR"
PROJ="$WORKDIR"
echo "job $SLURM_JOB_ID on $(hostname), started $(date -Is)"
apptainer exec /path/to/FigR/SC_GEX-ATAC.sif \
    Rscript "$PROJ/scripts/rev/gdt_chromvar.R" \
            "$PROJ/results/object_level" "$PROJ/results/gdt_chromvar"
echo "finished $(date -Is)"
