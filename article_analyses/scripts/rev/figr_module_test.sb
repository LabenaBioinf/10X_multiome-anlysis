#!/bin/bash
#SBATCH --job-name=misc_figr_module
#SBATCH --partition=cpu
#SBATCH --cpus-per-task=8
#SBATCH --mem=200G
#SBATCH --time=12:00:00
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err
set -euo pipefail
WORKDIR=/path/to/workdir
# container cache/tmp settings go here
export APPTAINER_BIND="/path/to/FigR"
PROJ="$WORKDIR"
echo "job $SLURM_JOB_ID on $(hostname), started $(date -Is)"
apptainer exec /path/to/FigR/SC_GEX-ATAC.sif \
    Rscript "$PROJ/scripts/rev/figr_module_test.R" \
            /path/to/FigR/objects/harmonized_seurat.rds \
            "$PROJ/results/figr_module" \
            "$PROJ/tables_extracted/AF2__17_Table_S8.tsv" \
            "$SLURM_CPUS_PER_TASK" "$PROJ/results/figr_differential"
echo "finished $(date -Is)"
